APP_ENV=development
AGENT_MODE=demo
AUTH_MODE=demo
STORE_BACKEND=memory
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only. Never use a VITE_ variable for the Gemini key.
GOOGLE_API_KEY=
# Replace with explicit model IDs available to your project before enabling Gemini.
GEMINI_MODEL=gemini-flash-latest
GEMINI_LITE_MODEL=gemini-flash-lite-latest
AGENT_TIMEOUT_SECONDS=45

# Optional Firebase / Firestore: install the cloud extra and use ADC.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Barcode lookup is offline by default. Enable only with an identifying User-Agent.
ENABLE_OPEN_FOOD_FACTS=false
OPEN_FOOD_FACTS_USER_AGENT=IntentCart/0.1 (replace-with-your-contact)
