APP_ENV=development
AGENT_MODE=demo
FOOD_RESEARCH_ENABLED=true
FOOD_RESEARCH_MAX_GAPS=12
FOOD_CACHE_DAYS=30
# Turn on the conversational Clothes agent independently of the Food scaffold.
# Requires Vertex AI ADC or GOOGLE_API_KEY below. Leave unset to follow AGENT_MODE.
# STYLIST_AGENT_MODE=gemini
# Enable later with a model/project that supports Google Search grounding.
# Enables live product discovery and Pinterest/web inspiration.
STYLIST_SEARCH_ENABLED=false
# AI concept boards and reference-photo edits (image model below).
STYLIST_IMAGES_ENABLED=true
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Local boutiques via Google Maps grounding; enable once your project supports it.
STYLIST_MAPS_ENABLED=false
# Shop a Look turns can call several tools; discovery runs in the background.
STYLIST_MAX_LLM_CALLS=12
STYLIST_TIMEOUT_SECONDS=120
DISCOVERY_TIMEOUT_SECONDS=180
# Reference uploads and concept images (ADK artifacts): file (backend/.data/artifacts),
# memory, or gcs with ARTIFACT_BUCKET. On Windows keep ARTIFACT_DIR short (path limits).
ARTIFACT_BACKEND=file
# ARTIFACT_DIR=/absolute/short/path
# ARTIFACT_BUCKET=
# Conversational Food agent mode and search capability (leave unset to follow AGENT_MODE)
# FOOD_AGENT_MODE=gemini
FOOD_SEARCH_ENABLED=true
# Food research may use several sources, so it has its own whole-turn limits.
FOOD_MAX_LLM_CALLS=10
FOOD_TIMEOUT_SECONDS=120
AUTH_MODE=demo
STORE_BACKEND=memory
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Vertex AI: authenticate locally with `gcloud auth application-default login`.
# See ../docs/vertex-ai.md for project setup and verification.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Used only when GOOGLE_GENAI_USE_VERTEXAI=false (Gemini Developer API).
# Server-only. Never use a VITE_ variable for the Gemini key.
GOOGLE_API_KEY=
# Replace with explicit model IDs available to your project before enabling Gemini.
GEMINI_MODEL=gemini-flash-latest
GEMINI_LITE_MODEL=gemini-flash-lite-latest
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_CONVERSATION_TURNS=40
# ADK conversation storage is separate from Firestore profiles/look-board records.
AGENT_SESSION_BACKEND=sqlite
# Default: backend/.data/agent_sessions.db. Use memory for isolated tests.
# AGENT_SESSION_DB_PATH=/absolute/path/to/agent_sessions.db

# Optional Firebase / Firestore: install the cloud extra and use the project above + ADC.
# Local user ADC does not need GOOGLE_APPLICATION_CREDENTIALS.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Barcode lookup is offline by default. Enable only with an identifying User-Agent.
ENABLE_OPEN_FOOD_FACTS=false
OPEN_FOOD_FACTS_USER_AGENT=IntentCart/0.1 (replace-with-your-contact)
