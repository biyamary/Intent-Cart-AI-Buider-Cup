APP_ENV=development
AGENT_MODE=demo
# Turn on the conversational Clothes agent independently of the Food scaffold.
# Requires GOOGLE_API_KEY below. Leave unset to follow AGENT_MODE.
# STYLIST_AGENT_MODE=gemini
# Enable later with a model/project that supports Google Search grounding.
STYLIST_SEARCH_ENABLED=false
AUTH_MODE=demo
STORE_BACKEND=memory
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Server-only. Never use a VITE_ variable for the Gemini key.
GOOGLE_API_KEY=
# Replace with explicit model IDs available to your project before enabling Gemini.
GEMINI_MODEL=gemini-flash-latest
GEMINI_LITE_MODEL=gemini-flash-lite-latest
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_CONVERSATION_TURNS=40
# ADK conversation storage is separate from Firestore profiles/look-board records.
AGENT_SESSION_BACKEND=sqlite
# Default: backend/.data/agent_sessions.db. Use memory for isolated tests.
# AGENT_SESSION_DB_PATH=/absolute/path/to/agent_sessions.db

# Optional Firebase / Firestore: install the cloud extra and use ADC.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Barcode lookup is offline by default. Enable only with an identifying User-Agent.
ENABLE_OPEN_FOOD_FACTS=false
OPEN_FOOD_FACTS_USER_AGENT=IntentCart/0.1 (replace-with-your-contact)
